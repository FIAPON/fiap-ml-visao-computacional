    "import time\n",
    "\n",
    "def estimar_profundidade(imagem_bgr):\n",
    "    \"\"\"Aplica MiDaS e retorna mapa de profundidade normalizado [0,1].\"\"\"\n",
    "    imgbatch = transform(imagem_bgr).to(device)\n",
    "    with torch.no_grad():\n",
    "        pred = midas(imgbatch)\n",
    "        pred = torch.nn.functional.interpolate(\n",
    "            pred.unsqueeze(1),\n",
    "            size=imagem_bgr.shape[:2],\n",
    "            mode=\"bicubic\",\n",
    "            align_corners=False,\n",
    "        ).squeeze()\n",
    "    output = pred.cpu().numpy()\n",
    "    return (output - output.min()) / (output.max() - output.min())\n",
    "\n",
    "\n",
    "def estimar_profundidade_depth_anything(imagem_bgr):\n",
    "    \"\"\"Aplica Depth Anything V2 e retorna mapa de profundidade normalizado [0,1].\"\"\"\n",
    "    imagem_rgb = cv2.cvtColor(imagem_bgr, cv2.COLOR_BGR2RGB)\n",
    "    h, w = imagem_bgr.shape[:2]\n",
    "    inputs = depth_anything_processor(images=imagem_rgb, return_tensors=\"pt\").to(device)\n",
    "    with torch.no_grad():\n",
    "        outputs = depth_anything_model(**inputs)\n",
    "        pred = torch.nn.functional.interpolate(\n",
    "            outputs.predicted_depth.unsqueeze(1),\n",
    "            size=(h, w),\n",
    "            mode=\"bicubic\",\n",
    "            align_corners=False,\n",
    "        ).squeeze()\n",
    "    output = pred.cpu().numpy()\n",
    "    return (output - output.min()) / (output.max() - output.min())\n",
    "\n",
    "\n",
    "def comparar_profundidade(imagem_bgr, titulo_extra=\"\"):\n",
    "    \"\"\"Roda MiDaS e Depth Anything V2 na mesma imagem e plota lado a lado:\n",
    "    Original | MiDaS | Depth Anything V2 — com o tempo de inferencia de cada modelo.\"\"\"\n",
    "    t0 = time.time()\n",
    "    depth_midas = estimar_profundidade(imagem_bgr)\n",
    "    tempo_midas = time.time() - t0\n",
    "\n",
    "    t0 = time.time()\n",
    "    depth_da = estimar_profundidade_depth_anything(imagem_bgr)\n",
    "    tempo_da = time.time() - t0\n",
    "\n",
    "    imagem_rgb = cv2.cvtColor(imagem_bgr, cv2.COLOR_BGR2RGB)\n",
    "\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(19, 6))\n",
    "    axes[0].imshow(imagem_rgb)\n",
    "    axes[0].set_title(f\"Imagem Original {titulo_extra}\".strip(), fontsize=13)\n",
    "    axes[0].axis(\"off\")\n",
    "\n",
    "    im1 = axes[1].imshow(depth_midas, cmap=\"plasma\")\n",
    "    axes[1].set_title(f\"MiDaS (Intel)\\n{tempo_midas*1000:.0f} ms\", fontsize=13)\n",
    "    axes[1].axis(\"off\")\n",
    "    plt.colorbar(im1, ax=axes[1], fraction=0.046, pad=0.04)\n",
    "\n",
    "    im2 = axes[2].imshow(depth_da, cmap=\"plasma\")\n",
    "    axes[2].set_title(f\"Depth Anything V2\\n{tempo_da*1000:.0f} ms\", fontsize=13)\n",
    "    axes[2].axis(\"off\")\n",
    "    plt.colorbar(im2, ax=axes[2], fraction=0.046, pad=0.04)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    mais_rapido = \"MiDaS\" if tempo_midas < tempo_da else \"Depth Anything V2\"\n",
    "    print(f\"  MiDaS (Intel):        {tempo_midas*1000:6.1f} ms\")\n",
    "    print(f\"  Depth Anything V2:    {tempo_da*1000:6.1f} ms\")\n",
    "    print(f\"  Mais rapido nesta imagem: {mais_rapido}\")\n",
    "\n",
    "    return depth_midas, depth_da\n"
   ]
