    "\n",
    "#  2. Segmentar cada detecção com SAM\n",
    "mask_predictor.set_image(image_rgb)\n",
    "\n",
    "# Paleta de cores para cada objeto\n",
    "palette = [\n",
    "    np.array([0,   200, 100]),\n",
    "    np.array([255, 100,  50]),\n",
    "    np.array([100, 150, 255]),\n",
    "    np.array([255, 220,   0]),\n",
    "    np.array([200,   0, 200]),\n",
