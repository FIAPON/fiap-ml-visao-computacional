    "# Carregando Depth Anything V2 (abordagem recomendada pela Ultralytics para complementar o YOLO)\n",
    "# Referencia: https://huggingface.co/depth-anything/Depth-Anything-V2-Small-hf\n",
    "!pip install transformers --quiet\n",
    "\n",
    "from transformers import AutoImageProcessor, AutoModelForDepthEstimation\n",
    "\n",
    "depth_anything_processor = AutoImageProcessor.from_pretrained(\"depth-anything/Depth-Anything-V2-Small-hf\")\n",
    "depth_anything_model = AutoModelForDepthEstimation.from_pretrained(\"depth-anything/Depth-Anything-V2-Small-hf\").to(device)\n",
    "depth_anything_model.eval()\n",
    "\n",
    "print(f\" Depth Anything V2 carregado | Device: {device}\")\n"
