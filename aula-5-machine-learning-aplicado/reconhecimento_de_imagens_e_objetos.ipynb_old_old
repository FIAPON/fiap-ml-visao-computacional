    "except NameError:\n",
    "    from segment_anything import SamPredictor\n",
    "    mask_predictor = SamPredictor(sam)\n",
    "\n",
    "\n",
    "yolo_results = model_yolo.predict(source=img_path, conf=0.4, verbose=False)\n",
    "boxes_xyxy   = yolo_results[0].boxes.xyxy.cpu().numpy()   # [N, 4] — x1,y1,x2,y2\n",
