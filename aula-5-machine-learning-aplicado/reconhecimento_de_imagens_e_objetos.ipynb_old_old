    "# 3.7 GradCAM — Explicabilidade da CNN\n",
    "import tensorflow as tf\n",
    "import cv2\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def gradcam_heatmap(model, img_array, last_conv_layer_name):\n",
    "    # GradCAM compativel com Keras 3 e modelos Sequential.\n",
    "    # Estrategia: forward pass manual camada a camada, interceptando\n",
    "    # a saida da conv alvo com tape.watch() — evita usar model.inputs\n",
    "    # e model.output que falham antes da primeira chamada no Keras 3.\n",
    "    # img_array: shape (1, H, W, 3), valores pre-processados.\n",
    "    target_idx    = next(i for i, l in enumerate(model.layers)\n",
    "                         if l.name == last_conv_layer_name)\n",
    "    layers_before = model.layers[:target_idx + 1]   # ate a conv alvo (incluso)\n",
    "    layers_after  = model.layers[target_idx + 1:]   # resto ate a saida\n",
    "\n",
    "    img_tensor = tf.cast(img_array, tf.float32)\n",
    "\n",
    "    with tf.GradientTape() as tape:\n",
    "        #  forward ate a camada alvo\n",
    "        x = img_tensor\n",
    "        for layer in layers_before:\n",
    "            x = layer(x)\n",
    "        conv_output = x\n",
    "        tape.watch(conv_output)      # registrar tensor para gradiente\n",
    "\n",
    "        #  continuar forward ate a saida\n",
    "        for layer in layers_after:\n",
    "            x = layer(x)\n",
    "        predictions = x\n",
    "\n",
    "        top_class   = tf.argmax(predictions[0])\n",
    "        class_score = predictions[:, top_class]\n",
    "\n",
    "    # Gradiente do score em relacao ao feature map\n",
    "    grads   = tape.gradient(class_score, conv_output)[0]  # (H, W, C)\n",
    "    weights = tf.reduce_mean(grads, axis=(0, 1))           # (C,) — importancia por canal\n",
    "    heatmap = tf.reduce_sum(weights * conv_output[0], axis=-1).numpy()  # (H, W)\n",
    "    heatmap = np.maximum(heatmap, 0)           # ReLU — so ativacoes positivas\n",
    "    heatmap = heatmap / (heatmap.max() + 1e-8) # normalizar 0-1\n",
    "    return heatmap, int(top_class), float(predictions[0, top_class])\n",
    "\n",
    "\n",
    "def overlay_gradcam(img_rgb, heatmap, alpha=0.45):\n",
    "    # Sobrepoe heatmap colorido sobre a imagem original.\n",
    "    h, w            = img_rgb.shape[:2]\n",
    "    heatmap_resized = cv2.resize(heatmap, (w, h))\n",
    "    colormap        = plt.get_cmap('jet')\n",
    "    heatmap_colored = (colormap(heatmap_resized)[:, :, :3] * 255).astype(np.uint8)\n",
    "    return (img_rgb * (1 - alpha) + heatmap_colored * alpha).astype(np.uint8)\n",
    "\n",
